            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path circ:economic_viability ],
        [ sh:datatype xsd:float ;
            sh:description "Recovery rate percentage" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path circ:recovery_rate ],
