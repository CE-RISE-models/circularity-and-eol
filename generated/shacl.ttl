            sh:description "Optional uncertainty statements for extraction process assumptions, recovery-rate estimates, or economic viability assessments" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path circ:recovery_methods_uncertainty_statements ] ;
    sh:targetClass circ:RecoveryMethods .

circ:RecyclableMaterials a sh:NodeShape ;
    rdfs:comment "Information about recyclable materials" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class dqf:dataQualityAssessment ;
            sh:description "Optional data quality assessments for recyclable material and recycling-rate data, evidence, provenance, completeness, or representativeness" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path circ:recyclable_materials_data_quality_assessments ],
        [ sh:datatype xsd:string ;
            sh:description "Required recycling process" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path circ:recycling_process ],
        [ sh:datatype xsd:float ;
            sh:description "Recycling rate as a percentage, per WFD Art. 3 (recycling only - reprocessing into products/materials/substances). Distinct from the broader recovery rate in traceability (RecyclingEvent.recovery_percentage)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path circ:recycling_rate ],
        [ sh:class uq:uncertaintyStatement ;
            sh:description "Optional uncertainty statements for recyclable material classification, recycling rate, or process assumptions" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path circ:recyclable_materials_uncertainty_statements ],
        [ sh:class mt:traceabilityStatement ;
            sh:description "Optional metrological traceability statements for recycling-rate measurements, material classification methods, standards, or reference data" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path circ:recyclable_materials_metrological_traceability_statements ],
        [ sh:datatype xsd:string ;
            sh:description "Type of recyclable material" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path circ:material_type ] ;
    sh:targetClass circ:RecyclableMaterials .

circ:RecyclingInfrastructure a sh:NodeShape ;
    rdfs:comment "Infrastructure requirements for recycling" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
