            sh:path circ:required_technology ],
        [ sh:datatype xsd:string ;
            sh:description "Geographic coverage" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path circ:geographic_availability ] ;
    sh:targetClass circ:RecyclingInfrastructure .

circ:RecyclingPathways a sh:NodeShape ;
    rdfs:comment "Material recycling pathways and infrastructure" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class circ:NonRecyclableMaterials ;
            sh:description "Materials that cannot be recycled" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path circ:non_recyclable_materials ],
        [ sh:class circ:RecyclableMaterials ;
            sh:description "Materials that can be recycled" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path circ:recyclable_materials ],
        [ sh:class circ:WEEERecyclingStream ;
            sh:description "WEEE-specific recycling/recovery streams with stream-level rates and allocation of treatment outcome to product input, per Directive 2012/19/EU" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path circ:weee_recycling_streams ],
        [ sh:class circ:RecyclingInfrastructure ;
            sh:description "Required recycling infrastructure" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path circ:recycling_infrastructure ] ;
    sh:targetClass circ:RecyclingPathways .

circ:ResourceEfficiency a sh:NodeShape ;
    rdfs:comment "Metrics related to resource use efficiency" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class uq:uncertaintyStatement ;
            sh:description "Optional uncertainty statements for resource-efficiency metrics such as material intensity, energy efficiency, water footprint, or waste generation" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path circ:resource_efficiency_uncertainty_statements ],
        [ sh:datatype xsd:float ;
            sh:description "Water consumption footprint" ;
