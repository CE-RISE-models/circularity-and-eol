            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path circ:lifespan_factors_data_quality_assessments ] ;
    sh:targetClass circ:LifespanFactors .

circ:MaterialCompositionEntry a sh:NodeShape ;
    rdfs:comment "Information about a specific material used in the product" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Type of material (metal, polymer, ceramic, composite, etc.)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path circ:material_type ],
        [ sh:class mt:traceabilityStatement ;
            sh:description "Optional metrological traceability statements for material composition measurements, methods, standards, calibrations, reference materials, or DMP-linked material evidence" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path circ:material_composition_metrological_traceability_statements ],
        [ sh:class dqf:dataQualityAssessment ;
            sh:description "Optional data quality assessments for material composition data, DMP references, supplier evidence, provenance, completeness, or representativeness" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path circ:material_composition_data_quality_assessments ],
        [ sh:datatype xsd:string ;
            sh:description "Geographic region where this material originated" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path circ:source_region ],
        [ sh:datatype xsd:float ;
            sh:description "Percentage of virgin content for this specific material" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path circ:virgin_content_percentage ],
        [ sh:description "URI reference to the Digital Material Passport (DMP) for this material" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path circ:dmp_reference ],
        [ sh:datatype xsd:float ;
            sh:description "Mass of this material in the product" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path circ:material_mass ],
        [ sh:datatype xsd:float ;
            sh:description "Percentage of recycled content for this specific material" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path circ:recycled_content_percentage ],
        [ sh:datatype xsd:float ;
            sh:description "Percentage of renewable content for this specific material" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path circ:renewable_content_percentage ],
        [ sh:datatype xsd:string ;
            sh:description "Reference to the supplier of this material (optional)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path circ:supplier_reference ],
        [ sh:class uq:uncertaintyStatement ;
            sh:description "Optional uncertainty statements for material mass, content percentages, source region, or supplier-reported material composition data" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path circ:material_composition_uncertainty_statements ] ;
