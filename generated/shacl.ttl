@prefix circ: <https://ce-rise-models.codeberg.page/circularity-and-eol/> .
@prefix dqf: <https://ce-rise-models.codeberg.page/data-quality-framework/> .
@prefix mt: <https://ce-rise-models.codeberg.page/metrological-traceability/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix uq: <https://ce-rise-models.codeberg.page/uncertainty-quantification/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

circ:CircularityAndEOL a sh:NodeShape ;
    rdfs:comment "Root container for circularity and end-of-life information" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class circ:BeginningOfLifeInformation ;
            sh:description "Material composition and origin information at product beginning of life" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path circ:beginning_of_life_information ],
        [ sh:class circ:DesignForCircularity ;
            sh:description "Design features that enable circular economy principles" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path circ:design_for_circularity ],
        [ sh:class circ:CircularityAssessments ;
            sh:description "Generic container for circularity assessments" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path circ:circularity_assessments ],
        [ sh:class circ:ProductPerformanceFactors ;
            sh:description "Quantifiable factors influencing circular performance" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path circ:product_performance_factors ],
        [ sh:class circ:EndOfLifeInformation ;
            sh:description "End-of-life pathways and recovery information" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path circ:end_of_life_information ] ;
    sh:targetClass circ:CircularityAndEOL .

dqf:dataQualityFramework a sh:NodeShape ;
    rdfs:comment "Root container for data quality assessments and supporting records" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class dqf:remediationAction ;
            sh:description "Remediation, mitigation, containment, or improvement actions" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path dqf:remediation_actions ],
        [ sh:class dqf:uncertaintyTranslation ;
            sh:description "Translations from data quality scores to uncertainty information" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path dqf:uncertainty_translations ],
        [ sh:class dqf:dataQualityAssessment ;
            sh:description "Reusable data quality assessments that can be embedded or referenced by other CE-RISE data models" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path dqf:data_quality_assessments ],
        [ sh:class dqf:qualityCriterionAssessment ;
            sh:description "Criterion-level pedigree assessments" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path dqf:criterion_assessments ],
        [ sh:class dqf:qualityMetric ;
            sh:description "Quality metrics or diagnostic metrics used by profiles, criteria, or diagnostics" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path dqf:quality_metrics ],
        [ sh:class dqf:qualityAggregation ;
            sh:description "Aggregations of data quality assessments, profiles, criteria, metrics, or uncertainty translations" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path dqf:quality_aggregations ],
        [ sh:class dqf:qualityDiagnostic ;
            sh:description "Data-quality diagnostic runs, checks, or analyses" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path dqf:quality_diagnostics ],
        [ sh:class dqf:dataQualityProfile ;
            sh:description "Data quality profiles available for reuse by one or more assessments" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path dqf:data_quality_profiles ],
        [ sh:class dqf:evidenceReference ;
            sh:description "Evidence records referenced by the data quality framework" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path dqf:data_quality_evidence_references ],
        [ sh:class dqf:qualityIssue ;
            sh:description "Data quality issues, limitations, anomalies, or risks" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path dqf:quality_issues ],
        [ sh:class dqf:dataCharacterization ;
            sh:description "Data characterization records available for reuse by one or more assessments" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path dqf:data_characterizations ] ;
    sh:targetClass dqf:dataQualityFramework .

mt:metrologicalTraceability a sh:NodeShape ;
    rdfs:comment "Root container for metrological traceability statements and supporting records" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class mt:traceabilityBasis ;
            sh:description "Reference bases used to establish metrological traceability" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path mt:traceability_bases ],
        [ sh:class mt:referenceMaterial ;
            sh:description "Reference materials and certified reference materials used in traceability" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path mt:reference_materials ],
        [ sh:class mt:measurementProcedure ;
            sh:description "Measurement, calculation, sampling, calibration, analytical, or modelling procedures used for traceability" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path mt:measurement_procedures ],
        [ sh:class mt:calibrationRecord ;
            sh:description "Calibration, comparison, verification, or check records that support traceability" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path mt:calibration_records ],
        [ sh:class mt:referenceEntity ;
            sh:description "Reference entities, standards, methods, instruments, datasets, or organizations used in traceability" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path mt:reference_entities ],
        [ sh:class mt:traceabilityStatement ;
            sh:description "Reusable traceability statements that can be embedded or referenced by other CE-RISE data models" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path mt:traceability_statements ],
        [ sh:class mt:comparabilityAssessment ;
            sh:description "Assessments of whether traceability statements support meaningful comparison" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path mt:comparability_assessments ],
        [ sh:class mt:traceabilityChain ;
            sh:description "Traceability chains or networks available for reuse by one or more traceability statements" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path mt:traceability_chains ],
        [ sh:class mt:evidenceReference ;
            sh:description "Evidence records referenced by the metrological traceability model" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path mt:traceability_evidence_references ],
        [ sh:class mt:competenceRecord ;
            sh:description "Competence, accreditation, validation, or quality system records supporting traceability" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path mt:competence_records ],
        [ sh:class mt:measurementStandard ;
            sh:description "Measurement standards, artefacts, instruments, and realizations used in traceability" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path mt:measurement_standards ],
        [ sh:class mt:boundaryDefinition ;
            sh:description "Boundary, goal-and-scope, scenario, or model definitions used as traceability references" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path mt:boundary_definitions ] ;
    sh:targetClass mt:metrologicalTraceability .

uq:uncertaintyQuantification a sh:NodeShape ;
    rdfs:comment "Root container for uncertainty quantification statements and supporting records" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class uq:methodReference ;
            sh:description "Methods, standards, and protocols referenced by the uncertainty model" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path uq:method_references ],
        [ sh:class uq:uncertaintyBudget ;
            sh:description "Uncertainty budgets available for reuse by one or more uncertainty statements" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path uq:uncertainty_budgets ],
        [ sh:class uq:comparisonAssessment ;
            sh:description "Assessments of whether uncertainty statements support meaningful comparison" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path uq:comparison_assessments ],
        [ sh:class uq:uncertaintyStatement ;
            sh:description "Reusable uncertainty statements that can be embedded or referenced by other CE-RISE data models" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path uq:uncertainty_statements ],
        [ sh:class uq:propagationAnalysis ;
            sh:description "Propagation analyses available for reuse by one or more uncertainty statements" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path uq:propagation_analyses ],
        [ sh:class uq:evidenceReference ;
            sh:description "Evidence records referenced by the uncertainty model" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path uq:uncertainty_evidence_references ] ;
    sh:targetClass uq:uncertaintyQuantification .

circ:Assessment a sh:NodeShape ;
    rdfs:comment "A single assessment instance with methodology and results" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "External reference" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path circ:assessment_reference ],
        [ sh:class mt:traceabilityStatement ;
            sh:description "Optional metrological traceability statements for assessment methods, reference standards, boundary definitions, data sources, or calculation chains" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path circ:assessment_metrological_traceability_statements ],
        [ sh:datatype xsd:string ;
            sh:description "Methodology used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path circ:assessment_methodology ],
        [ sh:datatype xsd:string ;
            sh:description "Version of methodology" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path circ:assessment_version ],
        [ sh:class dqf:dataQualityAssessment ;
            sh:description "Optional data quality assessments for assessment inputs, outputs, evidence, provenance, completeness, or representativeness" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path circ:assessment_data_quality_assessments ],
        [ sh:datatype xsd:string ;
            sh:description "Unit of score" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path circ:score_unit ],
        [ sh:datatype xsd:string ;
            sh:description "Type of assessment" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path circ:assessment_type ],
        [ sh:datatype xsd:float ;
            sh:description "Overall score" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path circ:assessment_score ],
        [ sh:datatype xsd:date ;
            sh:description "Date of assessment" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path circ:assessment_date ],
        [ sh:class uq:uncertaintyStatement ;
            sh:description "Optional uncertainty statements for assessment scores, methodology assumptions, boundaries, sub-scores, or certification-relevant results" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path circ:assessment_uncertainty_statements ],
        [ sh:datatype xsd:string ;
            sh:description "Data sources used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path circ:data_sources ],
        [ sh:datatype xsd:string ;
            sh:description "Valid score range" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path circ:score_range ],
        [ sh:datatype xsd:string ;
            sh:description "Certification status" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path circ:certification_status ],
        [ sh:class circ:SubScore ;
            sh:description "Breakdown of score components" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path circ:sub_scores ] ;
    sh:targetClass circ:Assessment .

circ:BeginningOfLifeInformation a sh:NodeShape ;
    rdfs:comment "Material composition and origin information at product beginning of life" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class circ:MaterialCompositionEntry ;
            sh:description "Individual material composition entries with DMP references" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path circ:material_composition_entries ],
        [ sh:class circ:ProductLevelSummary ;
            sh:description "Aggregated product-level composition summary" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path circ:product_level_summary ] ;
    sh:targetClass circ:BeginningOfLifeInformation .

circ:CRMRecovery a sh:NodeShape ;
    rdfs:comment "Critical raw materials recovery information" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class circ:CriticalMaterial ;
            sh:description "List of critical materials" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path circ:critical_materials_list ],
        [ sh:class circ:SecondaryRawMaterials ;
            sh:description "Secondary materials produced" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path circ:secondary_raw_materials ],
        [ sh:class circ:RecoveryMethods ;
            sh:description "Methods for recovery" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path circ:recovery_methods ] ;
    sh:targetClass circ:CRMRecovery .

circ:CircularCapability a sh:NodeShape ;
    rdfs:comment "Potential for circular economy strategies" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Potential for refurbishment" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path circ:refurbishment_potential ],
        [ sh:class uq:uncertaintyStatement ;
            sh:description "Optional uncertainty statements for reuse, refurbishment, remanufacturing, or recycling-potential estimates" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path circ:circular_capability_uncertainty_statements ],
        [ sh:datatype xsd:string ;
            sh:description "Potential for material recycling" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path circ:recycling_potential ],
        [ sh:class dqf:dataQualityAssessment ;
            sh:description "Optional data quality assessments for circular capability data, evidence, provenance, completeness, or representativeness" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path circ:circular_capability_data_quality_assessments ],
        [ sh:class mt:traceabilityStatement ;
            sh:description "Optional metrological traceability statements for circular capability assessment methods, assumptions, standards, reference data, or boundary definitions" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path circ:circular_capability_metrological_traceability_statements ],
        [ sh:datatype xsd:string ;
            sh:description "Potential for direct reuse" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path circ:reuse_potential ],
        [ sh:datatype xsd:string ;
            sh:description "Potential for remanufacturing" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path circ:remanufacturing_potential ] ;
    sh:targetClass circ:CircularCapability .

circ:CircularityAssessments a sh:NodeShape ;
    rdfs:comment "Container for circularity-related assessments of any type" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class circ:Assessment ;
            sh:description "Collection of assessments performed" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path circ:assessments ] ;
    sh:targetClass circ:CircularityAssessments .

circ:CollectionAndSorting a sh:NodeShape ;
    rdfs:comment "Waste collection and sorting information" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Available collection programs" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path circ:collection_schemes ],
        [ sh:datatype xsd:string ;
            sh:description "Sorting guidance" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path circ:sorting_instructions ],
        [ sh:datatype xsd:string ;
            sh:description "Waste classification codes" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path circ:waste_classification ],
        [ sh:datatype xsd:string ;
            sh:description "Take-back program details" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path circ:take_back_programs ] ;
    sh:targetClass circ:CollectionAndSorting .

circ:CriticalMaterial a sh:NodeShape ;
    rdfs:comment "Information about a critical raw material" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class dqf:dataQualityAssessment ;
            sh:description "Optional data quality assessments for CRM identification, quantity, concentration, evidence, provenance, completeness, or representativeness" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path circ:critical_material_data_quality_assessments ],
        [ sh:datatype xsd:string ;
            sh:description "Name of critical material" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path circ:material_name ],
        [ sh:datatype xsd:float ;
            sh:description "Concentration percentage" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path circ:concentration ],
        [ sh:class mt:traceabilityStatement ;
            sh:description "Optional metrological traceability statements for CRM quantity or concentration measurements, methods, standards, calibrations, or reference materials" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path circ:critical_material_metrological_traceability_statements ],
        [ sh:datatype xsd:float ;
            sh:description "Quantity present" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path circ:quantity ],
        [ sh:class uq:uncertaintyStatement ;
            sh:description "Optional uncertainty statements for critical material quantity, concentration, or identification" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path circ:critical_material_uncertainty_statements ] ;
    sh:targetClass circ:CriticalMaterial .

circ:DesignForCircularity a sh:NodeShape ;
    rdfs:comment "Design decisions and features that enable circular economy principles" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class circ:ModularDesign ;
            sh:description "Modularity aspects of the product design" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path circ:modular_design ],
        [ sh:class circ:MaterialSelection ;
            sh:description "Material choices supporting circularity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path circ:material_selection ],
        [ sh:class circ:DisassemblyFeatures ;
            sh:description "Features facilitating product disassembly" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path circ:disassembly_features ],
        [ sh:class circ:DurabilityFeatures ;
            sh:description "Features enhancing product durability and longevity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path circ:durability_features ] ;
    sh:targetClass circ:DesignForCircularity .

circ:DisassemblyFeatures a sh:NodeShape ;
    rdfs:comment "Product disassembly characteristics" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Tools needed for disassembly" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path circ:required_tools ],
        [ sh:class mt:traceabilityStatement ;
            sh:description "Optional metrological traceability statements for disassembly-time measurements, method definitions, test conditions, standards, or tooling assumptions" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path circ:disassembly_features_metrological_traceability_statements ],
        [ sh:class uq:uncertaintyStatement ;
            sh:description "Optional uncertainty statements for disassembly time, required tools, procedural assumptions, or disassembly evidence" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path circ:disassembly_features_uncertainty_statements ],
        [ sh:datatype xsd:string ;
            sh:description "Types of fasteners used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path circ:fastener_types ],
        [ sh:datatype xsd:float ;
            sh:description "Time required for disassembly" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path circ:disassembly_time ],
        [ sh:class dqf:dataQualityAssessment ;
            sh:description "Optional data quality assessments for disassembly data, instructions, evidence, provenance, completeness, or representativeness" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path circ:disassembly_features_data_quality_assessments ],
        [ sh:datatype xsd:string ;
            sh:description "Disassembly guidance" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path circ:disassembly_instructions ] ;
    sh:targetClass circ:DisassemblyFeatures .

circ:DurabilityFeatures a sh:NodeShape ;
    rdfs:comment "Product durability and maintenance characteristics" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class mt:traceabilityStatement ;
            sh:description "Optional metrological traceability statements for durability measurements, lifetime tests, repairability methods, standards, calibrations, or reference data" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path circ:durability_features_metrological_traceability_statements ],
        [ sh:class dqf:dataQualityAssessment ;
            sh:description "Optional data quality assessments for durability data, evidence, provenance, completeness, or representativeness" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path circ:durability_features_data_quality_assessments ],
        [ sh:datatype xsd:string ;
            sh:description "Repairability score or index" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path circ:repairability_index ],
        [ sh:datatype xsd:string ;
            sh:description "Maintenance requirements" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path circ:maintenance_schedule ],
        [ sh:datatype xsd:string ;
            sh:description "Upgrade possibilities" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path circ:upgrade_capability ],
        [ sh:datatype xsd:float ;
            sh:description "Expected operational lifetime" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path circ:expected_lifetime ],
        [ sh:class uq:uncertaintyStatement ;
            sh:description "Optional uncertainty statements for expected lifetime, repairability index, upgrade capability, or maintenance schedule assumptions" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path circ:durability_features_uncertainty_statements ] ;
    sh:targetClass circ:DurabilityFeatures .

circ:EndOfLifeInformation a sh:NodeShape ;
    rdfs:comment "Comprehensive end-of-life pathways and material recovery information" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class circ:TreatmentOptions ;
            sh:description "Final treatment and disposal options" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path circ:treatment_options ],
        [ sh:class circ:RecyclingPathways ;
            sh:description "Recycling routes and infrastructure" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path circ:recycling_pathways ],
        [ sh:class circ:CollectionAndSorting ;
            sh:description "Collection and sorting systems" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path circ:collection_and_sorting ],
        [ sh:class circ:CRMRecovery ;
            sh:description "Critical raw materials recovery" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path circ:crm_recovery ] ;
    sh:targetClass circ:EndOfLifeInformation .

circ:EnergyRecovery a sh:NodeShape ;
    rdfs:comment "Energy recovery from waste" ;
